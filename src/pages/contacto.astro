---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="Contacto | Faktis"
  description="Resolvemos tus dudas en menos de 24 horas hábiles. Escríbenos o contáctanos por WhatsApp."
>
  <Header />
  <main>
    <!-- Hero corto -->
    <section class="page-hero">
      <div class="fk-wrap">
        <h1>Hablemos.</h1>
        <p>Resolvemos tus dudas en menos de 24 horas h&aacute;biles.</p>
      </div>
    </section>

    <!-- Contenido -->
    <section class="sec">
      <div class="fk-wrap">
        <ContactForm />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
