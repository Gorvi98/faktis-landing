---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="Contacto | Faktis"
  description="Resolvemos tus dudas en menos de 24 horas hábiles. Escríbenos o contáctanos por WhatsApp."
>
  <Header />
  <main>
    <!-- Hero corto -->
    <section class="bg-[#0F172A] text-white px-4 sm:px-6 lg:px-8 py-16 sm:py-20 text-center">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-[2rem] sm:text-4xl font-bold text-white mb-4"
            style="font-family:'Inter Tight','Inter',sans-serif; letter-spacing:-0.03em;">
          Hablemos.
        </h1>
        <p class="text-[#94A3B8] text-lg">
          Resolvemos tus dudas en menos de 24 horas h&aacute;biles.
        </p>
      </div>
    </section>

    <!-- Contenido -->
    <section class="bg-[#F8FAFC] px-4 sm:px-6 lg:px-8 py-16">
      <div class="max-w-5xl mx-auto">
        <ContactForm />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
