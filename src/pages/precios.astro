---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PricingCards from '../components/PricingCards.astro';
import DespachoSocio from '../components/DespachoSocio.astro';
import FAQ from '../components/FAQ.astro';
import CTABanner from '../components/CTABanner.astro';
---

<Layout
  title="Precios | Faktis"
  description="Planes simples sin sorpresas. Desde $499 MXN/mes para contadores independientes hasta ilimitado para despachos."
>
  <Header />
  <main>
    <!-- Hero corto -->
    <section class="page-hero">
      <div class="fk-wrap">
        <p class="sec-eyebrow center">Planes</p>
        <h1>Precios simples. Sin <em>sorpresas.</em></h1>
        <p>Elige el plan que se ajuste a tu volumen mensual.</p>
      </div>
    </section>

    <PricingCards />
    <DespachoSocio />
    <FAQ />
    <CTABanner />
  </main>
  <Footer />
</Layout>
