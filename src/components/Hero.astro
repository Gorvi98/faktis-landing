---
// Hero — fondo dark, headline + 2 CTAs + badge
const APP_URL = 'https://bot-cfdi-tester.streamlit.app';
---

<section class="bg-[#0F172A] text-white px-4 sm:px-6 lg:px-8 py-20 sm:py-28">
  <div class="max-w-4xl mx-auto text-center">

    <!-- Eyebrow -->
    <p class="fk-eyebrow mb-6">Automatización contable para México</p>

    <!-- Headline -->
    <h1
      class="text-[2.25rem] sm:text-5xl font-bold text-white mb-4"
      style="letter-spacing:-0.025em; line-height:1.12;"
    >
      Faktis clasifica tus CFDI<br class="hidden sm:block" /> en segundos.
    </h1>

    <!-- Subheadline -->
    <p class="text-xl sm:text-2xl text-[#94A3B8] font-medium mb-5" style="letter-spacing:-0.01em;">
      Tú firmas los estados financieros.
    </p>

    <!-- Descripción -->
    <p class="text-[#64748B] text-base sm:text-lg max-w-2xl mx-auto mb-10 leading-relaxed">
      Procesa lotes de comprobantes fiscales, clasifica con IA y exporta a Excel listo para tu ERP.
      Sin captura manual, sin errores.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-10">
      <a href={APP_URL} class="btn-primary text-base px-6 py-3" target="_blank" rel="noopener noreferrer">
        Probar gratis &rarr;
      </a>
      <a href="#features" class="btn-secondary text-base px-6 py-3" style="color:#94A3B8 !important; border-color:#334155;">
        Ver cómo funciona
      </a>
    </div>

    <!-- Badge -->
    <p class="fk-eyebrow" style="color:#475569;">
      Hecho en CDMX por contadores, para contadores
    </p>
  </div>
</section>
