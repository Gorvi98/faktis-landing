---
// Hero — split oscuro/claro con mock de lote CFDI
import MockTable from './MockTable.astro';

const APP_URL = 'https://bot-cfdi-tester.streamlit.app';
---

<section class="hero page" id="inicio" data-screen-label="01 Hero">
  <div class="hero-left">
    <div class="hero-content">
      <p class="hero-eyebrow">CFDI 4.0 · Clasificado con IA</p>

      <h1 class="hero-h1">
        Carga tus XMLs.<br />
        Faktis <em>hace el resto.</em>
      </h1>

      <p class="hero-sub">
        Lee, valida y clasifica tus facturas a cuentas SAT en segundos.
        Tú firmas los estados financieros.
      </p>

      <div class="hero-ctas">
        <a class="fk-btn-primary" href={APP_URL} target="_blank" rel="noopener noreferrer">
          Accede a tu cuenta
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
          </svg>
        </a>
        <a class="fk-btn-secondary" href="#como-funciona">Ver cómo funciona</a>
      </div>

      <div class="hero-trust">
        <span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          CFDI 4.0
        </span>
        <span style="opacity:.4">·</span>
        <span>SAT validado</span>
        <span style="opacity:.4">·</span>
        <span>Datos en México</span>
      </div>
    </div>
  </div>

  <div class="hero-right">
    <MockTable />
    <div class="mock-anno a2"><strong>4.2s</strong> · 12 CFDIs</div>
  </div>
</section>
