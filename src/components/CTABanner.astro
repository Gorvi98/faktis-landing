---
// Banner final de conversión
const APP_URL = 'https://bot-cfdi-tester.streamlit.app';
---

<section class="bg-[#0F172A] px-4 sm:px-6 lg:px-8 py-16">
  <div class="max-w-3xl mx-auto text-center">
    <h2
      class="text-2xl sm:text-3xl font-bold text-white mb-3"
      style="letter-spacing:-0.025em;"
    >
      &iquest;Listo para procesar tus CFDI?
    </h2>
    <p class="text-[#94A3B8] text-base mb-8">
      Empieza hoy. Sin tarjeta, sin instalaciones.
    </p>
    <a
      href={APP_URL}
      class="inline-flex items-center gap-2 bg-[#1D9E75] text-white font-semibold text-base
             px-7 py-3.5 rounded-[6px] hover:bg-[#0F6E56] transition-colors no-underline"
      target="_blank"
      rel="noopener noreferrer"
    >
      Empezar gratis &rarr;
    </a>
  </div>
</section>
