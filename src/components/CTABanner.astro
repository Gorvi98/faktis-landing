---
// Banner final de conversión — homologado con el break oscuro .cta-final
const APP_URL = 'https://bot-cfdi-tester.streamlit.app';
---

<section class="cta-final" data-screen-label="CTA final">
  <div class="fk-wrap">
    <p class="sec-eyebrow">Empieza hoy</p>
    <h2>&iquest;Listo para procesar tus <em>CFDI?</em></h2>
    <p>Empieza hoy. Sin tarjeta, sin instalaciones.</p>
    <div class="ctas">
      <a class="fk-btn-primary" href={APP_URL} target="_blank" rel="noopener noreferrer">
        Empezar gratis
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
