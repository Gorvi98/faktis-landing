---
// Dos planes de precios
const APP_URL = 'https://bot-cfdi-tester.streamlit.app';

const plans = [
  {
    name:     'Básico',
    badge:    null,
    price:    '$499',
    period:   'MXN /mes',
    subtitle: 'Para contadores independientes',
    features: [
      'Hasta 200 XML por mes',
      'Clasificación con IA',
      'Catálogo SAT estándar',
      'Catálogo personalizado',
      'Export a Excel',
      'Soporte por email',
    ],
    cta:       'Empezar plan Básico',
    highlight: false,
  },
  {
    name:     'Pro',
    badge:    'Más popular',
    price:    '$999',
    period:   'MXN /mes',
    subtitle: 'Para despachos y empresas',
    features: [
      'XMLs ilimitados',
      'Todo lo de Básico',
      'Múltiples RFCs',
      'Histórico de procesamientos',
      'Soporte prioritario por WhatsApp',
      'Onboarding personalizado',
    ],
    cta:       'Empezar plan Pro',
    highlight: true,
  },
];
---

<section class="sec">
  <div class="fk-wrap">

    <div style="text-align:center; margin-bottom:48px;">
      <p class="sec-eyebrow center">Planes</p>
      <h2 class="sec-h2 center">Elige tu plan.</h2>
      <p class="sec-lede center">Elige el plan que se ajuste a tu volumen mensual.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
      {plans.map(({ name, badge, price, period, subtitle, features, cta, highlight }) => (
        <div
          class="relative flex flex-col rounded-[10px] p-7 border transition-shadow"
          style={highlight
            ? 'border-color:var(--fk-teal); background:#fff; box-shadow:var(--fk-shadow-pop);'
            : 'border-color:var(--fk-border); background:#fff;'}
        >
          {/* Badge */}
          {badge && (
            <span
              class="absolute -top-3 left-1/2 -translate-x-1/2 text-xs font-semibold px-3 py-1 rounded-full"
              style="background:var(--fk-teal); color:#fff; font-family:var(--fk-font-mono); letter-spacing:0.04em;"
            >
              {badge}
            </span>
          )}

          {/* Nombre + subtítulo */}
          <p class="fk-secondary text-xs font-semibold uppercase tracking-widest mb-1">{name}</p>
          <p class="fk-secondary text-sm mb-5">{subtitle}</p>

          {/* Precio */}
          <div class="flex items-baseline gap-1 mb-6">
            <span
              class="text-4xl font-bold"
              style="font-family:var(--fk-font-display); color:var(--fk-dark); font-variant-numeric:tabular-nums; letter-spacing:-0.035em;"
            >{price}</span>
            <span class="fk-secondary text-sm">{period}</span>
          </div>

          {/* Features */}
          <ul class="space-y-2.5 mb-8 flex-1">
            {features.map(f => (
              <li class="flex items-start gap-2.5 text-sm" style="color:var(--fk-dark);">
                <svg
                  class="flex-shrink-0 mt-0.5"
                  width="16" height="16" viewBox="0 0 24 24"
                  fill="none" stroke="var(--fk-teal)" stroke-width="2.5"
                  stroke-linecap="round" stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                {f}
              </li>
            ))}
          </ul>

          {/* CTA */}
          <a
            href={APP_URL}
            class={highlight ? 'btn-primary justify-center text-sm' : 'btn-secondary justify-center text-sm'}
            target="_blank"
            rel="noopener noreferrer"
          >
            {cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
