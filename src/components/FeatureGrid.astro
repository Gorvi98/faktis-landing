---
// Cuatro razones — grid de features (DS v1.1 tints), homologado con .sec/.fk-wrap

const features = [
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: 'De 3 horas a 3 minutos',
    desc:  'Procesa lotes de CFDI mientras te tomas un caf&eacute;. Sin captura manual, sin errores tipogr&aacute;ficos.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    title: 'IA que entiende contabilidad mexicana',
    desc:  'No es un OCR gen&eacute;rico. Faktis conoce CFDI&nbsp;4.0, complementos del SAT, retenciones y el cat&aacute;logo de cuentas SAT.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="15" x2="12" y2="15"/></svg>`,
    title: 'Tu cat&aacute;logo, tus reglas',
    desc:  'Sube tu propio cat&aacute;logo de cuentas en Excel. Faktis clasifica con tus c&oacute;digos, no con plantillas gen&eacute;ricas.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`,
    title: 'T&uacute; revisas. T&uacute; firmas.',
    desc:  'Faktis propone, t&uacute; decides. Cada CFDI se puede revisar y reclasificar manualmente antes del export final.',
  },
];
---

<section class="sec" id="por-que-faktis">
  <div class="fk-wrap">
    <div style="text-align:center; margin-bottom:56px;">
      <p class="sec-eyebrow center">Por qué Faktis</p>
      <h2 class="sec-h2 center">Cuatro razones para dejar la <em>captura manual.</em></h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {features.map(({ icon, title, desc }) => (
        <div class="fk-card hover:shadow-sm transition-shadow">
          <!-- Ícono en badge teal (DS v1.1 tints) -->
          <div
            class="w-10 h-10 rounded-lg flex items-center justify-center mb-4"
            style="background:var(--fk-teal-50); color:var(--fk-teal-700);"
            set:html={icon}
          />
          <h3 class="fk-h3 mb-2" set:html={title} />
          <p class="fk-secondary text-sm" style="line-height:1.6;" set:html={desc} />
        </div>
      ))}
    </div>
  </div>
</section>
