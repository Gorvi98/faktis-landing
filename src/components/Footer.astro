---
// Footer — homologado con .footer/.footer-grid del Design System
---

<footer class="footer">
  <div class="fk-wrap">
    <div class="footer-grid">

      <!-- Brand -->
      <div class="footer-brand">
        <img src="/assets/faktis-logo.png" alt="Faktis" />
        <p>Convierte el caos fiscal en claridad instantánea. CFDI 4.0 clasificado con IA, hecho en México.</p>
      </div>

      <!-- Producto -->
      <div>
        <h5>Producto</h5>
        <ul>
          <li><a href="/">Inicio</a></li>
          <li><a href="/precios">Precios</a></li>
          <li>
            <a href="https://bot-cfdi-tester.streamlit.app" target="_blank" rel="noopener noreferrer">Demo</a>
          </li>
        </ul>
      </div>

      <!-- Empresa -->
      <div>
        <h5>Empresa</h5>
        <ul>
          <li><a href="/contacto">Contacto</a></li>
          <li><a href="/aviso-privacidad">Aviso de privacidad</a></li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h5>Social</h5>
        <ul>
          <li>
            <a href="#" style="display:inline-flex; align-items:center; gap:6px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="4"/>
                <line x1="8" y1="10" x2="8" y2="16"/>
                <line x1="8" y1="7" x2="8" y2="7.5"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <path d="M12 12a3 3 0 0 1 6 0v4"/>
              </svg>
              LinkedIn
            </a>
          </li>
          <li>
            <a href="#" style="display:inline-flex; align-items:center; gap:6px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
              </svg>
              TikTok
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; 2026 Faktis. Hecho en CDMX por contadores, para contadores.</span>
      <div class="fb-right">
        <span>CFDI · Contabilidad · IA</span>
      </div>
    </div>
  </div>
</footer>
