---
// Formulario de contacto — HTML sin backend por ahora, homologado con .fk-field
---

<div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

  <!-- Form -->
  <div>
    <form action="#" method="POST" id="contact-form" novalidate>
      <div class="fk-field">
        <label for="nombre">Nombre</label>
        <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre completo" />
      </div>

      <div class="fk-field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="tu@correo.com" />
      </div>

      <div class="fk-field">
        <label for="empresa">Empresa <span class="hint">(opcional)</span></label>
        <input type="text" id="empresa" name="empresa" placeholder="Nombre de tu despacho o empresa" />
      </div>

      <div class="fk-field">
        <label for="mensaje">Mensaje</label>
        <textarea id="mensaje" name="mensaje" required rows="4" placeholder="¿En qué podemos ayudarte?"></textarea>
      </div>

      <button type="submit" class="fk-btn-primary" style="width:100%; justify-content:center; padding:13px 18px;">
        Enviar mensaje
      </button>
    </form>

    <!-- Aviso "en construcción" -->
    <div id="form-notice" class="hidden" style="margin-top:16px; font-size:13px; color:var(--fk-slate-mid); background:var(--fk-white); border:1px solid var(--fk-border); border-radius:var(--fk-radius-sm); padding:12px 16px;">
      En construcci&oacute;n &mdash; usa WhatsApp por ahora para contactarnos.
    </div>
  </div>

  <!-- Bloque alternativo: WhatsApp + info -->
  <div class="space-y-5">

    <!-- WhatsApp card -->
    <div
      class="rounded-[10px] border p-6 flex flex-col items-start gap-4"
      style="border-color:var(--fk-border); background:linear-gradient(135deg, var(--fk-teal-50) 0%, #F0FDF9 100%);"
    >
      <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background:#25D366;">
        <!-- WhatsApp SVG -->
        <svg width="24" height="24" viewBox="0 0 24 24" fill="white" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
        </svg>
      </div>
      <div>
        <p class="fk-h3" style="margin-bottom:4px;">¿Prefieres WhatsApp?</p>
        <p class="fk-secondary text-sm" style="margin-bottom:16px;">Respondemos al instante en horario h&aacute;bil.</p>
        <a
          href="https://wa.me/521XXXXXXXXXX"
          target="_blank"
          rel="noopener noreferrer"
          class="fk-btn-primary text-sm"
          style="background:#25D366;"
          aria-label="Abrir conversación en WhatsApp"
        >
          Abrir WhatsApp &rarr;
        </a>
      </div>
    </div>

    <!-- Info de contacto -->
    <div class="space-y-3 text-sm fk-secondary">
      <div class="flex items-center gap-2.5">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--fk-teal)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        hola@faktis.com.mx
      </div>
      <div class="flex items-center gap-2.5">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--fk-teal)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Lunes a viernes, 9:00 &ndash; 18:00 CDMX
      </div>
      <div class="flex items-center gap-2.5">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--fk-teal)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Ciudad de M&eacute;xico
      </div>
    </div>
  </div>
</div>

<script>
  // Muestra aviso "en construcción" al enviar
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    document.getElementById('form-notice')?.classList.remove('hidden');
  });
</script>
