---
// Card especial para despachos — 30% comisión
const benefits = [
  'Acceso ilimitado sin costo',
  '30% de comisión por cada referido',
  'Material de venta listo para enviar',
  'Onboarding para tu equipo',
];
---

<section class="bg-[#0F172A] px-4 sm:px-6 lg:px-8 py-20">
  <div class="max-w-4xl mx-auto">
    <div
      class="rounded-[16px] border border-[#1E293B] bg-[#111827] p-8 sm:p-12"
      style="box-shadow:0 0 0 1px var(--fk-teal-tint-12), 0 20px 40px rgba(0,0,0,0.3);"
    >
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">

        <!-- Texto -->
        <div>
          <p class="fk-eyebrow mb-4" style="color:#34D399;">Para despachos contables</p>
          <h2 class="text-2xl sm:text-3xl font-semibold text-white mb-4"
              style="font-family:'Inter Tight','Inter',sans-serif; letter-spacing:-0.025em;">
            &iquest;Eres despacho contable?
          </h2>
          <p class="text-[#94A3B8] text-base leading-relaxed mb-8">
            Usa Faktis gratis. Refiere a tus clientes y gana
            <strong style="color:#34D399;">30% de comisi&oacute;n recurrente</strong>
            por cada uno.
          </p>
          <a
            href="/contacto"
            class="btn-primary text-sm"
          >
            Hablar con ventas &rarr;
          </a>
        </div>

        <!-- Beneficios -->
        <ul class="space-y-3">
          {benefits.map(b => (
            <li class="flex items-center gap-3 text-sm text-[#CBD5E1]">
              <div
                class="w-7 h-7 rounded-md flex items-center justify-center flex-shrink-0"
                style="background:var(--fk-teal-tint-14);"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#34D399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </div>
              {b}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
