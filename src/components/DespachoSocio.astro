---
// Card especial para despachos — 30% comisión, homologado con .partner/.partner-card
const benefits = [
  'Acceso ilimitado sin costo',
  '30% de comisión por cada referido',
  'Material de venta listo para enviar',
  'Onboarding para tu equipo',
];
---

<section class="partner">
  <div class="fk-wrap">
    <div class="partner-card">

      <!-- Texto -->
      <div>
        <p class="sec-eyebrow">Para despachos contables</p>
        <h2>&iquest;Eres despacho contable?</h2>
        <p>
          Usa Faktis gratis. Refiere a tus clientes y gana
          <strong>30% de comisi&oacute;n recurrente</strong>
          por cada uno.
        </p>
        <a href="/contacto" class="fk-btn-primary">
          Hablar con ventas
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Beneficios -->
      <ul class="partner-list">
        {benefits.map(b => (
          <li>
            <span class="icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </span>
            {b}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
